{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter Web (Edge)",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"edge",
				"--web-renderer",
				"html"
			],
			"isBackground": false,
			"problemMatcher": [
				"$dart-flutter"
			],
			"group": "build"
		},
		{
			"label": "Flutter Pub Get",
			"type": "shell",
			"command": "flutter",
			"args": [
				"pub",
				"get"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build Runner Generate",
			"type": "shell",
			"command": "flutter",
			"args": [
				"pub",
				"run",
				"build_runner",
				"build",
				"--delete-conflicting-outputs"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}